import 'lib/nat/mem.ej'
import 'std'

native {
    pub fn set_int(num:int):int {
        // Save ptr
        ptr = malloc(1)
        set_ptr(ptr, num)

        return ptr
    }

    pub fn get_int(ptr:int):int {
        return get_ptr(ptr)
    }
}

num = 50
ptr = set_int(num)
print!(ptr)

pnum = get_int(ptr)
print!(pnum)

fn t_test() {
    print!("Inside t_test")
}

t::test()